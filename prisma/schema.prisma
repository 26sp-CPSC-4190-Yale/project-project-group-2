// ------------------------------------
// User
// ------------------------------------

model User {
	id 				String		@id @default(cuid())	// cuid() creates a 30 character long collision id
	email 		String		@unique
	password 	String
	name 			String?													// ? denotes an optional field
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@updatedAt

	// Relations
	calendars Calendar[]
}

// ------------------------------------
// Calendar
// ------------------------------------

model Calendar {
	id				String		@id @default(cuid())
	title			String		@default("Calendar")
	createdAt	DateTime	@default(now())
	updatedAt	DateTime	@updatedAt

	userId		String

	// Relations
	user			User			@relation(fields: [userId], references: [id], onDelete: Cascade)
}
