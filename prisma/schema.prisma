generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  googleId  String?  @unique
  email     String   @unique
  password  String?
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendars Calendar[]
  tasks     Task[]
}

model Calendar {
  id          String   @id @default(cuid())
  title       String   @default("Calendar")
  color       String   @default("none")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groups Group[]
}

model Group {
  id    String  @id @default(cuid())
  name  String  @default("Group")
  notes String?
  color String  @default("none")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDefault Boolean @default(false)

  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  events Event[]
  tasks  Task[]
}

model Event {
  id          String    @id @default(cuid())
  name        String    @default("New Event")
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(true)
  link        String?
  description String?
  notes       String?
  location    String?
  remindBefore Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  tasks Task[]
}

model Task {
  id           String   @id @default(cuid())
  name         String
  dueAt        DateTime
  allDay       Boolean  @default(true)
  completed    Boolean  @default(false)
  notes        String?
  remindBefore Int?
  link         String?
  location     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}